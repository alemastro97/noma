{
  "name": "noma",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:fast": "tauri build --bundles app -- --profile release-fast",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm check:rust",
    "check:rust": "vite build && cd src-tauri && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@xyflow/react": "^12.12.1",
    "lucide-react": "^1.72.0",
    "motion": "^14.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^22",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-refresh": "^0.5",
    "jsdom": "^27",
    "prettier": "^3",
    "typescript": "~5.9",
    "typescript-eslint": "^8",
    "vite": "^8.3.8",
    "vitest": "^4"
  },
  "license": "SEE LICENSE IN LICENSE"
}
