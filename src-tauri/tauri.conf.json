{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOMA",
  "version": "0.3.0",
  "identifier": "com.noma.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "NOMA",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#111116",
        "visible": false
      },
      {
        "label": "orb",
        "title": "NOMA orb",
        "url": "src/windows/orb/index.html",
        "width": 176,
        "height": 176,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "acceptFirstMouse": true,
        "x": 1100,
        "y": 40
      },
      {
        "label": "capture",
        "title": "NOMA quick capture",
        "url": "src/windows/capture/index.html",
        "width": 500,
        "height": 190,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "resizable": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "NOMA \u2014 your second mind.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
